    "WebRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "rol-novatrix-v46-web",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "rol-novatrix-v46-web"
          }
        ],
        "Description": "Webbservern: l\u00e4ser databasens l\u00f6senord ur Secrets Manager och l\u00e4gger dumpar i backup-bucketen, inget annat."
      }
    },
    "WebInstanceProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "InstanceProfileName": "ipr-novatrix-v46-web",
        "Roles": [
          {
            "Ref": "WebRole"
          }
        ]
      }
    },
    "WebInstance": {
      "Type": "AWS::EC2::Instance",
      "DependsOn": [
        "DefaultRoute",
        "WebSubnetRoutes"
      ],
      "Properties": {
        "ImageId": {
          "Ref": "WebImage"
        },
        "InstanceType": "t3.micro",
        "MetadataOptions": {
          "HttpTokens": "required"
        },
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "VolumeType": "gp3",
              "VolumeSize": 8,
              "Encrypted": true,
              "DeleteOnTermination": true
            }
          }
        ],
        "NetworkInterfaces": [
          {
            "DeviceIndex": "0",
            "SubnetId": {
              "Ref": "WebSubnet"
            },
            "GroupSet": [
              {
                "Ref": "WebSecurityGroup"
              }
            ],
            "AssociatePublicIpAddress": true,
            "DeleteOnTermination": true
          }
        ],
        "UserData": {
          "Fn::Base64": {
            "Fn::Join": [
              "",
              [
                {
                  "Fn::Select": [
                    0,
                    {
                      "Fn::Split": [
                        "      MOV_ENVIRONMENT_HERE=here\n",
                        {
                          "Ref": "WebUserData"
                        }
                      ]
                    }
                  ]
                },
                "      DB_HOST=",
                {
                  "Fn::GetAtt": [
                    "Db",
                    "Endpoint.Address"
                  ]
                },
                "\n",
                "      DB_NAME=",
                "wordpress",
                "\n",
                "      DB_SECRET=",
                {
                  "Fn::GetAtt": [
                    "Db",
                    "MasterUserSecret.SecretArn"
                  ]
                },
                "\n",
                "      EFS_ID=",
                {
                  "Ref": "Files"
                },
                "\n",
                "      BACKUP_BUCKET=",
                {
                  "Ref": "Backups"
                },
                "\n",
                {
                  "Fn::Select": [
                    1,
                    {
                      "Fn::Split": [
                        "      MOV_ENVIRONMENT_HERE=here\n",
                        {
                          "Ref": "WebUserData"
                        }
                      ]
                    }
                  ]
                }
              ]
            ]
          }
        },
        "PropagateTagsToVolumeOnCreation": true,
        "Tags": [
          {
            "Key": "Name",
            "Value": "ec2-novatrix-v46-web"
          }
        ],
        "IamInstanceProfile": {
          "Ref": "WebInstanceProfile"
        }
      }
    },
    "Dbsubnets": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "Properties": {
        "DBSubnetGroupDescription": "De tv\u00e5 privata subn\u00e4ten, ett i varje zon.",
        "SubnetIds": [
          {
            "Ref": "Data1Subnet"
          },
          {
            "Ref": "Data2Subnet"
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": "dbsubnets-novatrix-v46"
          }
        ]
      }
    },
    "Db": {
      "Type": "AWS::RDS::DBInstance",
      "Properties": {
        "Engine": "mariadb",
        "DBInstanceClass": "db.t4g.micro",
        "AllocatedStorage": "20",
        "StorageType": "gp2",
        "StorageEncrypted": true,
        "DBName": "wordpress",
        "MasterUsername": "wpadmin",
        "ManageMasterUserPassword": true,
        "DBSubnetGroupName": {
          "Ref": "Dbsubnets"
        },
        "VPCSecurityGroups": [
          {
            "Ref": "DbSecurityGroup"
          }
        ],
        "PubliclyAccessible": false,
        "MultiAZ": false,
        "BackupRetentionPeriod": 1,
        "DeleteAutomatedBackups": true,
        "DeletionProtection": false,
        "Tags": [
          {
            "Key": "Name",
            "Value": "db-novatrix-v46"
          }
        ]
      }
    },
    "Files": {
      "Type": "AWS::EFS::FileSystem",
      "Properties": {
        "Encrypted": true,
        "PerformanceMode": "generalPurpose",
        "ThroughputMode": "bursting"
      }
    },
    "Files1": {
      "Type": "AWS::EFS::MountTarget",
      "Properties": {
        "FileSystemId": {
          "Ref": "Files"
        },
        "SubnetId": {
          "Ref": "Data1Subnet"
        },
        "SecurityGroups": [
          {
            "Ref": "FilesSecurityGroup"
          }
        ]
      }
    },
    "Files2": {
      "Type": "AWS::EFS::MountTarget",
      "Properties": {
        "FileSystemId": {
          "Ref": "Files"
        },
        "SubnetId": {
          "Ref": "Data2Subnet"
        },
        "SecurityGroups": [
          {
            "Ref": "FilesSecurityGroup"
          }
        ]
      }
    },
    "Backups": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "db-dumps",
              "Status": "Enabled",
              "Prefix": "db/",
              "ExpirationInDays": 14
            }
          ]
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": "backups-novatrix-v46"
          }
        ]
      }
    },
    "Webaccess": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "ManagedPolicyName": "pol-novatrix-v46-web",
        "Description": "Webbserverns beh\u00f6righeter: l\u00e4sa databasens l\u00f6senord och l\u00e4gga dumpar under db/ i backup-bucketen.",
        "Roles": [
          {
            "Ref": "WebRole"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "ReadDbSecret",
              "Effect": "Allow",
              "Action": "secretsmanager:GetSecretValue",
              "Resource": {
                "Fn::GetAtt": [
                  "Db",
                  "MasterUserSecret.SecretArn"
                ]
              }
            },
            {
              "Sid": "WriteDumps",
              "Effect": "Allow",
              "Action": "s3:PutObject",
              "Resource": {
                "Fn::Sub": "${Backups.Arn}/db/*"
              }
            },
            {
              "Sid": "ListDumps",
              "Effect": "Allow",
              "Action": "s3:ListBucket",
              "Resource": {
                "Fn::GetAtt": [
                  "Backups",
                  "Arn"
                ]
              }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "VpcId": {
      "Value": {
        "Ref": "Vpc"
      }
    },
    "WebRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "WebRole",
          "Arn"
        ]
      }
    },
    "WebRoleName": {
      "Value": {
        "Ref": "WebRole"
      }
    },
    "WebInstanceId": {
      "Value": {
        "Ref": "WebInstance"
      }
    },
    "WebPrivateIp": {
      "Value": {
        "Fn::GetAtt": [
          "WebInstance",
          "PrivateIp"
        ]
      }
    },
    "WebPublicIp": {
      "Value": {
        "Fn::GetAtt": [
          "WebInstance",
          "PublicIp"
        ]
      }
    }
  }
}
